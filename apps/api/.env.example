# Copie para .env e preencha. Nunca coloque valores reais neste arquivo.

# Banco
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"
PORT=3333

# WhatsApp Cloud API
# Senha que você inventa e cadastra no painel da Meta ao configurar o webhook
WHATSAPP_VERIFY_TOKEN="troque-este-token"
# Painel do app > Configurações > Básico > App Secret
WHATSAPP_APP_SECRET="cole-o-app-secret-aqui"
# true = não envia nada para a Meta; só grava no banco e mostra no terminal
WHATSAPP_DRY_RUN="true"
# Painel do app > WhatsApp > Configuração da API (token permanente: Usuários do sistema)
WHATSAPP_ACCESS_TOKEN=""
# ID do número (não é o número em si). Quando preenchido, o bot só atende mensagens
# que chegam a este número e responde sempre por ele.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v23.0"
# Número da empresa com 55 e DDD. Aparece no painel e nos links wa.me dos anúncios.
WHATSAPP_BUSINESS_NUMBER="5561998665922"

# Senha inicial dos usuários criados pelo seed (mínimo 8 caracteres)
SEED_PASSWORD="troque-esta-senha"

# Painel
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="12h"
WEB_ORIGIN="http://localhost:5173"
